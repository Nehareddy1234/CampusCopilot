# Vercel / Main Application Environment Variables
PORT=3000
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Connection to Render Scraper Microservice
SCRAPER_SERVICE_URL=https://campus-copilot-scraper.onrender.com
# INTERNAL_API_KEY must match scraper-service/.env exactly
INTERNAL_API_KEY=your_secure_random_shared_secret_here

# --- LMS Monitor (scheduled notification alerts) ---
# Your VIT LMS credentials, used only by the monitor script
VIT_USERNAME=your_vit_registration_number
VIT_PASSWORD=your_vit_password
# Alert channel: googlechat | console
ALERT_CHANNEL=googlechat
# Incoming webhook URL from a Google Chat space (Space settings > Apps & integrations > Manage webhooks)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=...&token=...
# Hours before a deadline at which to warn (default 24)
DEADLINE_WARN_HOURS=24
# Where the monitor keeps its last-seen snapshot
MONITOR_STATE_FILE=data/state.json
