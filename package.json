{
  "name": "campus-copilot",
  "version": "0.1.0",
  "description": "Automation and chatbot for VIT LMS",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "dev:all": "concurrently -n MAIN,SCRAPER -c blue,magenta \"npm run dev\" \"npm run dev --prefix scraper-service\"",
    "monitor": "ts-node src/monitor.ts",
    "start": "node dist/server.js",
    "test": "tsc && node test_notify.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "marked": "^18.0.4",
    "node-cron": "^4.6.0",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "concurrently": "^10.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
